# dx_data_collector — Example Environment Variables
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# These variables are used in the YAML config files
# (dx_data_collector/config/*.yaml, docker/chart/configs/*.yaml).

# S3 / Object Storage Output
# --------------------------
# S3-compatible endpoint URL (e.g. https://s3.amazonaws.com, https://s3.us-west-1.wasabisys.com)
S3_ENDPOINT_URL=https://s3.amazonaws.com

# S3 bucket name to upload data to
S3_BUCKET=your-data-collection-bucket

# Logical environment label stored in the S3 key path (e.g. dev, staging, prod)
S3_ENV=dev

# Logical area/prefix stored in the S3 key path (e.g. robot-cell-1, test-collection)
S3_AREA=data-collection

# AWS credentials — set via standard AWS SDK mechanisms:
#   - Environment variables: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
#   - Shared credentials file: ~/.aws/credentials
#   - IAM instance role (if running on AWS EC2/EKS)
# The aws_profile field in config files refers to a named profile in ~/.aws/credentials.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_PROFILE=default

# Filesystem Output
# -----------------
# Local path where filesystem outputter writes data
FS_OUTPUT_PATH=/tmp/dx_data_collector

# ROS
# ---
# ROS master URI (override if roscore is not on localhost)
# ROS_MASTER_URI=http://localhost:11311
