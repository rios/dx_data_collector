<?xml version="1.0"?>
<package format="2">
  <name>dx_data_collector</name>
  <version>0.0.1</version>
  <description>Subsystem for collecting and exporting data from ROS</description>

  <!-- One maintainer tag required, multiple allowed, one person per tag -->
  <maintainer email="maintainers@example.com">RIOS AI</maintainer>

  <license>Apache-2.0</license>

  <author>Leo Keselman</author>
  <author>Shubham Kanitkar</author>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>roscpp_serialization</depend>
  <depend>rosbag_storage</depend>
  <depend>dx_data_collector_msgs</depend>
  <depend>dx_sysmon_sdk</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>dx_rios_yaml</depend>
  <depend>cv_bridge</depend>
  <depend>rosbag</depend>
  <depend>tf2_ros</depend>

  <test_depend>rosunit</test_depend>
  <test_depend>gtest</test_depend>
  <test_depend>sensor_msgs</test_depend>
</package>
