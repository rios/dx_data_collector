// For format details, see https://aka.ms/devcontainer.json.
//
// For defining the docker image to run, change the `--image` option in `initializeCommand` 
//     - `develop`: will try to run the image with the 'develop' tag
//	       - Example: <internal_registry>/${localWorkspaceFolderBasename}:develop
//     - `branch`: will try to run the latest image for the branch
//	       - Example: <internal_registry>/${localWorkspaceFolderBasename}:feature_branch
//     - `current`: will try to run image with current hash for ref
//	       - Example: <internal_registry>/${localWorkspaceFolderBasename}:develop-8df416
//     - `latest`: will try to run the image with 'latest' tag
//	       - Example: <internal_registry>/${localWorkspaceFolderBasename}:latest
//     - `main`: will try to run the image with the 'main' tag
//	       - Example: <internal_registry>/${localWorkspaceFolderBasename}:main
//     - `build`: will try to build then run the image with the 'current' tag
//
//     - or define a specific image to run by providing the full image name 
//			(e.g. `--image <internal_registry>/${localWorkspaceFolderBasename}:develop-8df416`)
// 
// For example: 
//     `./run.sh --image <internal_registry>/${localWorkspaceFolderBasename}:develop-8df416`
//
{
	"name": "rios-frameworks-dev-container",
	"image": "<internal_registry>/${localWorkspaceFolderBasename}-development:latest",
	"initializeCommand":"/bin/bash -e -c 'cd ${localWorkspaceFolder}/docker && ./devcontainer.sh --image build'",	
	"runArgs": [ "--net", "host", 
                //"--gpus","all",
                "-e", "DISPLAY=${localEnv:DISPLAY}", 
                "--volume", "/tmp/.X11-unix:/tmp/.X11-unix", 
                "--volume", "/dev/snd:/dev/snd",
                 "-v", "${localEnv:HOME}/.bashrc:${localEnv:HOME}.bashrc",
		        "-v", "${localEnv:HOME}/.aws:${localEnv:HOME}/.aws",
                //"-v", "${localEnv:HOME}/.zshrc:${localENV:HOME}.zshrc", // For the zsh users!
                "-v", "${localEnv:HOME}/.ssh:${localEnv:HOME}/.ssh",
                "-v", "${localEnv:HOME}/.gitconfig:${localEnv:HOME}/.gitconfig",
                "-v", "${localEnv:HOME}/.kube:${localEnv:HOME}/.kube",
                "--privileged",
				        "--shm-size", "8G" // for training !! (May need to be increased for larger models)
			   ],

	"containerUser": "${localEnv:USER}",

	"remoteUser": "${localEnv:USER}",

	"mounts": [
		// This will mount a local copy of .bash_history to maintain local history (where local changes are ignored in .gitgnore)
		"source=${localWorkspaceFolder}/.devcontainer/.bash_history,target=${localEnv:HOME}/.bash_history,type=bind,consistency=cached" 
	],

	"workspaceMount": "source=${localWorkspaceFolder},target=/opt/rios/src/${localWorkspaceFolderBasename},type=bind,consistency=cached",
	
	"workspaceFolder": "/opt/rios/src/${localWorkspaceFolderBasename}",

	"onCreateCommand": "sudo chown -R ${localEnv:USER} /opt/rios"
}
